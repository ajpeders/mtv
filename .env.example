MTV_SYNC_INTERVAL=6h
# internal URL used by mtv-sync to enrich manifest credits; blank disables it
#MTV_MEDIADB_URL=http://mediadb:8090

# --- docker-compose.standalone.yml ---
# host port, or ADDRESS:PORT to bind one interface. /admin has NO AUTH.
#MTV_PORT=8080
# youtube = mirror channel playlists (default); files = air the mp4s in the videos dir
#MTV_SOURCE=files
# state (channels.json, playlists.txt) and videos; defaults ./data/config, ./data/videos
#MTV_CONFIG_PATH=./data/config
#MTV_VIDEOS_PATH=./data/videos
# sync/admin run as this user so the dirs stay yours
#MTV_UID=1000
#MTV_GID=1000
# 1 = transcode downloads to HEVC; 0 (default) keeps H.264
#MTV_HEVC_TRANSCODE=0
